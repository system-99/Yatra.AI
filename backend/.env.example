# Google Gemini API Key (for itinerary generation)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API Key (for weather lookup and forecasts)
WEATHER_API_KEY=your_weather_api_key_here

# TomTom API Key (for geocoding and routing services)
TOMTOM_API_KEY=your_tomtom_api_key_here

# Supabase project settings (use the publishable/anon key, never service_role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
